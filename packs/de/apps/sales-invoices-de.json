          }
        ]
      }
    },
    {
      "view_id": "ust-je-monat",
      "version": 3,
      "notion": "analysis",
      "title": "Umsatzsteuer je Monat",
      "domain": "finance",
      "function": "vat",
      "spec": {
        "sql_file": "ust-je-monat.sql",
        "columns": [
          {
            "field": "month",
            "label": "Monat",
            "type": "string"
          },
          {
            "field": "rate",
            "label": "Satz",
