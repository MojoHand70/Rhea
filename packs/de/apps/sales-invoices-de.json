          },
          {
            "field": "gross",
            "label": "Brutto",
            "type": "money"
          }
        ]
      }
    }
  ],
  "record": {
    "of": "sales_invoice",
    "tabs": [
      {
        "view_id": "rechnung-detail",
        "version": 1,
        "notion": "detail",
        "title": "Ausgangsrechnung",
        "domain": "finance",
        "function": "documents",
        "spec": {
          "object_type": "sales_invoice",
          "sections": [
            {
              "title": "Rechnung",
              "fields": [
                "number",
                "issue_date"
              ]
            },
            {
              "title": "Parteien",
              "fields": [
                "buyer"
              ]
            },
            {
              "title": "Beträge",
              "fields": [
                "net",
                "vat",
                "gross",
                "vat_rate",
                "currency"
              ]
            }
          ]
        }
      }
    ]
  },
  "rules": [
    {
      "rule_id": "de-book-sales-invoice",
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Eine ausgestellte EUR-Rechnung wird zum sales_invoice-Dokument",
      "spec": {
        "match": {
          "event_type": "sales.invoice.issued",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "de"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "sales_invoice",
            "fields": {
              "number": "=$.number",
              "issue_date": "=$.issue_date",
              "buyer": "=ref(company, vat_id, $.buyer_nip)",
              "net": "=$.net",
              "vat": "=$.vat",
              "gross": "=$.gross",
              "vat_rate": "=ref(vat_rate, code, $.vat_rate)",
              "currency": "=$.currency",
              "seller": "=ref(company, vat_id, $.seller_nip)"
            }
          }
        }
      }
    },
    {
      "rule_id": "de-post-sales-invoice",
      "priority": 200,
      "effective_from": "2026-01-01",
      "description": "EUR-Rechnung bucht: 1400 brutto / 8400 netto, 1776 USt",
      "spec": {
        "match": {
          "event_type": "sales.invoice.issued",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "de"
            }
          ]
        },
        "effect": {
          "postings": {
            "currency": "=$.currency",
            "lines": [
              {
                "account": "1400",
                "debit": "=$.gross"
              },
              {
                "account": "8400",
                "credit": "=$.net"
              },
              {
                "account": "1776",
                "credit": "=$.vat"
              }
            ],
            "book": "de-stat"
          }
        }
      }
    }
  ]
}
