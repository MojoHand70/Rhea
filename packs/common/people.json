  "rules": [
    {
      "rule_id": "register-person",
      "priority": 10,
      "effective_from": "2026-01-01",
      "description": "A registered person becomes a person object, active from the day of registration",
      "spec": {
        "match": {
          "event_type": "person.registered"
        },
        "effect": {
          "object": {
            "type": "person",
            "fields": {
              "name": "=$.name",
              "handle": "=$.handle",
              "role": "=$.role",
              "status": "active"
            }
          }
        }
      }
    },
    {
      "rule_id": "appoint-deputy",
      "priority": 10,
      "effective_from": "2026-01-01",
      "description": "Appointing a deputy amends the person: work addressed to them can be routed to the deputy while they are away",
      "spec": {
        "match": {
          "event_type": "person.deputy_appointed"
        },
        "effect": {
          "amend": {
            "type": "person",
            "target": "=$.person",
            "set": {
              "deputy": "=$.deputy"
            }
          }
        }
      }
    },
    {
      "rule_id": "move-person-status",
      "priority": 10,
      "effective_from": "2026-01-01",
      "description": "A person's status moves along the declared lifecycle: active ⇄ away, either → left; the kernel refuses any other move",
      "spec": {
        "match": {
          "event_type": "person.status_changed"
        },
        "effect": {
          "amend": {
            "type": "person",
            "target": "=$.person",
            "set": {
              "status": "=$.status"
            }
          }
        }
      }
    },
    {
      "rule_id": "identify-person",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "A person's names and birth date, as they said them",
      "spec": {
        "match": {
          "event_type": "person.identified"
        },
        "effect": {
          "amend": {
            "type": "person",
            "target": "=$.person",
            "set": {
              "given_name": "=$.given_name",
              "family_name": "=$.family_name",
              "birth_date": "=$.birth_date"
            }
          }
        }
      }
    },
    {
      "rule_id": "declare-role",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "A declared role becomes a role object: a named set of rights, the pack's or a company's own",
      "spec": {
        "match": {
          "event_type": "role.declared"
        },
        "effect": {
          "object": {
            "type": "role",
            "fields": {
              "name": "=$.name",
              "rights": "=$.rights",
              "description": "=coalesce($.description, \"\")"
            }
          }
        }
      }
    },
    {
      "rule_id": "change-role",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Changing a role's rights amends it; what was granted under the old rights stays explained by the old version of the fact",
      "spec": {
        "match": {
          "event_type": "role.changed"
        },
        "effect": {
          "amend": {
            "type": "role",
            "target": "=$.role",
            "set": {
              "rights": "=$.rights",
              "description": "=coalesce($.description, \"\")"
            }
          }
        }
      }
    },
    {
      "rule_id": "grant-membership",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "A granted membership puts a person in a company with a role from a date, open-ended; the grant is signed by who granted it",
      "spec": {
        "match": {
          "event_type": "membership.granted",
          "where": [
            {
              "path": "$.to",
              "op": "absent"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "membership",
            "fields": {
              "person": "=$.person",
              "company": "=$.company",
              "role": "=$.role",
              "group": "=coalesce($.group, \"\")",
              "from": "=$.from",
              "reason": "=coalesce($.reason, \"\")",
              "status": "active",
              "granted_by": "=$.granted_by"
            }
          }
        }
      }
    },
    {
      "rule_id": "grant-membership-until",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "A granted membership with a last day — a guest, a day of support, a fixed-term contract",
      "spec": {
        "match": {
          "event_type": "membership.granted",
          "where": [
            {
              "path": "$.to",
              "op": "exists"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "membership",
            "fields": {
              "person": "=$.person",
              "company": "=$.company",
              "role": "=$.role",
              "group": "=coalesce($.group, \"\")",
              "from": "=$.from",
              "reason": "=coalesce($.reason, \"\")",
              "status": "active",
              "granted_by": "=$.granted_by",
              "to": "=$.to"
            }
          }
        }
      }
    },
    {
      "rule_id": "end-membership",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "An ended membership keeps its history and grants nothing after its last day",
      "spec": {
        "match": {
          "event_type": "membership.ended"
        },
        "effect": {
          "amend": {
            "type": "membership",
            "target": "=$.membership",
            "set": {
              "status": "ended",
              "to": "=$.to"
            }
          }
        }
      }
    },
    {
      "rule_id": "grant-mandate",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "A granted mandate lets an office keep a client's books within a scope of rights from a date — KSeF's authorised entity",
      "spec": {
        "match": {
          "event_type": "mandate.granted",
          "where": [
            {
              "path": "$.to",
              "op": "absent"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "mandate",
            "fields": {
              "office": "=$.office",
              "client": "=$.client",
              "scope": "=$.scope",
              "from": "=$.from",
              "status": "active",
              "granted_by": "=$.granted_by"
            }
          }
        }
      }
    },
    {
      "rule_id": "grant-mandate-until",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "A granted mandate with a last day",
      "spec": {
        "match": {
          "event_type": "mandate.granted",
          "where": [
            {
              "path": "$.to",
              "op": "exists"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "mandate",
            "fields": {
              "office": "=$.office",
              "client": "=$.client",
              "scope": "=$.scope",
              "from": "=$.from",
              "status": "active",
              "granted_by": "=$.granted_by",
              "to": "=$.to"
            }
          }
        }
      }
    },
    {
      "rule_id": "end-mandate",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "An ended mandate keeps its history; the office's people lose the client on its last day",
      "spec": {
        "match": {
          "event_type": "mandate.ended"
        },
        "effect": {
          "amend": {
            "type": "mandate",
            "target": "=$.mandate",
            "set": {
              "status": "ended",
              "to": "=$.to"
            }
          }
        }
      }
    },
    {
      "rule_id": "appoint-substitute",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "A substitution hands a person's rights to a deputy between two dates, in one company or (left empty) in every company of theirs; nothing after",
      "spec": {
        "match": {
          "event_type": "substitution.appointed"
        },
        "effect": {
          "object": {
            "type": "substitution",
            "fields": {
              "person": "=$.person",
              "deputy": "=$.deputy",
              "from": "=$.from",
              "to": "=$.to",
              "status": "active",
              "granted_by": "=$.granted_by",
              "company": "=coalesce($.company, \"\")"
            }
          }
        }
      }
    },
    {
      "rule_id": "end-substitution",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "An ended substitution stops on the day it is ended",
      "spec": {
        "match": {
          "event_type": "substitution.ended"
        },
        "effect": {
          "amend": {
            "type": "substitution",
            "target": "=$.substitution",
            "set": {
              "status": "ended",
              "to": "=$.to"
            }
          }
        }
      }
    },
    {
      "rule_id": "declare-group",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "A declared group names a set of a company's people, for rights granted at once and for a supervisor's reach",
      "spec": {
        "match": {
          "event_type": "group.declared"
        },
        "effect": {
          "object": {
            "type": "group",
            "fields": {
              "name": "=$.name",
              "company": "=$.company",
              "description": "=coalesce($.description, \"\")"
            }
          }
        }
      }
    }
  ],
