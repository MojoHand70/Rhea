  ],
  "tabs": [
    {
      "view_id": "company-list",
      "version": 1,
      "notion": "list",
      "title": "Companies",
      "domain": "finance",
      "function": "master data",
      "spec": {
        "object_type": "company",
        "columns": [
          {
            "field": "name",
            "label": "Name"
          },
          {
            "field": "kind",
            "label": "Kind"
          },
          {
            "field": "country",
            "label": "Country"
          }
        ]
      }
    }
  ],
  "record": {
    "of": "company",
    "tabs": [
      {
        "view_id": "company-detail",
        "version": 1,
        "notion": "detail",
        "title": "Company",
        "domain": "finance",
        "function": "master data",
        "spec": {
          "object_type": "company",
          "sections": [
            {
              "title": "Company",
              "fields": [
                "name",
                "kind"
              ]
            },
            {
              "title": "Registration",
              "fields": [
                "vat_id",
                "country"
              ]
            }
          ]
        }
      }
    ]
  },
  "actions": [
    {
      "name": "set_financial_year",
      "domain": "finance",
      "description": "The company acted for says the month its financial year begins in: January for the calendar year, another month for a year of twelve full months from the first of it. Reports count their opening balances and \"from the start of the year\" from that day; a company that says nothing keeps the calendar year",
      "spec": {
        "inputs": [
          {
            "name": "financial_year_start",
            "type": "enum",
            "required": true,
            "values": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07",
              "08",
              "09",
              "10",
              "11",
              "12"
            ]
          },
          {
            "name": "occurred_at",
            "type": "date"
          }
        ],
        "emits": "company.financial_year.set",
        "who": [
          "human"
        ]
      }
    }
  ],
  "rules": [
    {
      "rule_id": "core-set-financial-year",
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "The month the company's financial year begins in, as it says, on its own record",
      "spec": {
        "match": {
          "event_type": "company.financial_year.set"
        },
        "effect": {
          "amend": {
            "type": "company",
            "target": "=ref(company, kind, \"self\")",
            "set": {
              "financial_year_start": "=$.financial_year_start"
            }
          }
        }
      }
    }
  ]
}
