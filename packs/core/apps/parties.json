          ],
          "required": true
        },
        {
          "name": "vat_id",
          "type": "string",
          "required": false
        },
        {
          "name": "country",
          "type": "string",
          "required": false
        },
        {
          "name": "financial_year_start",
          "type": "enum",
          "required": false,
          "values": [
            "01",
            "02",
            "03",
            "04",
            "05",
            "06",
            "07",
            "08",
            "09",
            "10",
            "11",
            "12"
          ]
        }
      ],
      "amendable": [
        "financial_year_start"
      ]
    },
    {
      "name": "contractor",
      "version": 1,
      "domain": "finance",
      "is_document": false,
      "label_field": "name",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "nip",
          "type": "string"
        },
        {
          "name": "regon",
          "type": "string"
        },
        {
          "name": "address",
