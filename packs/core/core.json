    {
      "view_id": "trial-balance",
      "version": 2,
      "notion": "analysis",
      "title": "Trial balance",
      "domain": "finance",
      "function": "analysis",
      "spec": {
        "sql": "SELECT book, code, account, d AS debit, c AS credit, d - c AS balance FROM (SELECT COALESCE(json_extract_string(p.state,'$.book'),'main') AS book, json_extract_string(a.state,'$.code') AS code, json_extract_string(a.state,'$.name') AS account, COALESCE(SUM(CASE WHEN json_extract_string(p.state,'$.side')='debit' THEN CAST(json_extract(p.state,'$.amount') AS BIGINT) ELSE 0 END),0) AS d, COALESCE(SUM(CASE WHEN json_extract_string(p.state,'$.side')='credit' THEN CAST(json_extract(p.state,'$.amount') AS BIGINT) ELSE 0 END),0) AS c FROM objects p JOIN objects a ON json_extract_string(p.state,'$.account') = a.object_id WHERE p.object_type = 'posting' AND a.object_type = 'account' GROUP BY 1, 2, 3) t ORDER BY book, code",
        "columns": [
          {
            "field": "book",
            "label": "Book",
            "type": "string"
          },
          {
            "field": "code",
            "label": "Code",
            "type": "string"
          },
          {
            "field": "account",
            "label": "Account",
            "type": "string"
          },
          {
            "field": "debit",
            "label": "Debit",
            "type": "money"
          },
          {
            "field": "credit",
            "label": "Credit",
            "type": "money"
          },
          {
            "field": "balance",
            "label": "Balance",
            "type": "money"
          }
        ]
      }
    },
