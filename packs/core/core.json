    {
      "view_id": "invoice-by-customer",
      "version": 2,
      "notion": "analysis",
      "title": "Invoice totals by customer",
      "domain": "finance",
      "function": "analysis",
      "spec": {
        "sql": "SELECT json_extract_string(c.state, '$.name') AS customer, COUNT(*) AS invoices, SUM(CAST(json_extract(i.state, '$.total') AS BIGINT)) AS total FROM objects i JOIN objects c ON json_extract_string(i.state, '$.customer') = c.object_id WHERE i.object_type = 'invoice' AND c.object_type = 'company' GROUP BY 1 ORDER BY total DESC",
        "columns": [
          {
            "field": "customer",
            "label": "Customer",
            "type": "string"
          },
          {
            "field": "invoices",
            "label": "Invoices",
            "type": "int"
          },
          {
            "field": "total",
            "label": "Total",
            "type": "money"
          }
        ]
      }
    },
