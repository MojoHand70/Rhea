{
  "app": "vehicles",
  "version": 3,
  "title": "Samochody i leasing",
  "layer": "law",
  "place": {
    "activity": "assets"
  },
  "shows": [
    "desk",
    "phone"
  ],
  "data": [
    {
      "name": "vehicle",
      "version": 1,
      "domain": "finance",
      "is_document": false,
      "label_field": "registration",
      "fields": [
        {
          "name": "registration",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "enum",
          "values": [
            "car",
            "truck",
            "motorcycle",
            "other"
          ]
        },
        {
          "name": "engine_capacity",
          "type": "int"
        },
        {
          "name": "ownership",
          "type": "enum",
          "values": [
            "own",
            "leasing",
            "rental",
            "private"
          ]
        },
        {
          "name": "active",
          "type": "enum",
          "values": [
            "yes",
            "no"
          ]
        },
        {
          "name": "default",
          "type": "enum",
          "values": [
            "yes",
            "no"
          ]
        }
      ]
    },
    {
      "name": "mileage_entry",
      "version": 1,
      "domain": "finance",
      "is_document": false,
      "fields": [
        {
          "name": "date",
          "type": "date",
          "required": true
        },
        {
          "name": "vehicle",
          "type": "ref<vehicle>",
          "required": true
        },
        {
          "name": "route_start",
          "type": "string"
        },
        {
          "name": "route_end",
          "type": "string"
        },
        {
          "name": "km",
          "type": "int",
          "required": true
        }
      ]
    },
    {
      "name": "lease_contract",
      "version": 2,
      "domain": "finance",
      "is_document": false,
      "label_field": "number",
      "lifecycle": {
        "field": "status",
        "transitions": {
          "active": [
            "active",
            "ended"
          ]
        }
      },
      "amendable": [
        "status",
        "next_period",
        "end"
      ],
      "fields": [
        {
          "name": "number",
          "type": "string",
          "required": true
        },
        {
          "name": "kind",
          "type": "enum",
          "required": true,
          "values": [
            "operational",
            "financial",
            "rental"
          ],
          "description": "rodzaj umowy, jak nazywa ją rynek i ustawa o CIT: leasing operacyjny (art. 17b), finansowy (art. 17f) albo najem"
        },
        {
          "name": "books",
          "type": "enum",
          "required": false,
          "values": [
            "finance",
            "operating"
          ],
          "description": "jak księgi traktują umowę: leasing finansowy — przedmiot wśród środków trwałych, zobowiązanie wobec finansującego, rata dzielona na kapitał i odsetki wewnętrzną stopą zwrotu (art. 3 ust. 4 UoR, KSR 5) — albo operacyjny: raty kosztem, jak w podatku (uproszczenie art. 3 ust. 6 UoR)"
        },
        {
          "name": "lessor",
          "type": "ref<company>",
          "required": false
        },
        {
          "name": "start",
          "type": "date",
          "description": "dzień przyjęcia przedmiotu leasingu do używania"
        },
        {
          "name": "end",
          "type": "date"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "net",
          "type": "money"
        },
        {
          "name": "vat",
          "type": "money"
        },
        {
          "name": "gross",
          "type": "money"
        },
        {
          "name": "vat_deduction_limit",
          "type": "money"
        },
        {
          "name": "vat_deducted",
          "type": "money"
        },
        {
          "name": "asset_value",
          "type": "money",
          "required": false,
          "description": "wartość przedmiotu leasingu netto z umowy: wartość początkowa środka trwałego i zobowiązania u korzystającego"
        },
        {
          "name": "initial_fee",
          "type": "money",
          "required": false,
          "description": "opłata wstępna netto, płatna przy przyjęciu przedmiotu"
        },
        {
          "name": "instalment",
          "type": "money",
          "required": false,
          "description": "rata netto"
        },
        {
          "name": "months",
          "type": "int",
          "required": false,
          "description": "liczba miesięcy od pierwszej do ostatniej raty"
        },
        {
          "name": "every",
          "type": "int",
          "required": false,
          "description": "co ile miesięcy przypada rata"
        },
        {
          "name": "residual",
          "type": "money",
          "required": false,
          "description": "cena wykupu netto, płatna z ostatnią ratą"
        },
        {
          "name": "first_instalment",
          "type": "date",
          "required": false
        },
        {
          "name": "depreciation_rate",
          "type": "decimal",
          "required": false,
          "description": "roczna stawka amortyzacji przedmiotu w księgach, w procentach"
        },
        {
          "name": "effective_rate",
          "type": "decimal",
          "required": false,
          "description": "wewnętrzna stopa zwrotu umowy w skali roku, w procentach: stopa, którą raty i wykup dyskontują się do wartości przedmiotu pomniejszonej o opłatę wstępną"
        },
        {
          "name": "next_period",
          "type": "string",
          "required": false,
          "description": "miesiąc, w którym do ksiąg wejdą następne odsetki z harmonogramu; pusty, gdy wszystkie weszły"
        },
        {
          "name": "status",
          "type": "enum",
          "required": false,
          "values": [
            "active",
            "ended"
          ]
        }
      ]
    }
  ]
}
