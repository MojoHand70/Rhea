  "actions": [
    {
      "name": "propose_bank_account",
      "domain": "finance",
      "description": "Osoba zgłasza rachunek bankowy firmy: nazwa, numer IBAN (sprawdzany: kraj, długość, cyfry kontrolne), waluta, bank — rachunek czeka na zatwierdzenie przez Bankowość, a wyciągi z niego czekają na ten rachunek",
      "spec": {
        "inputs": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "number",
            "type": "string",
            "required": true,
            "format": "iban"
          },
          {
            "name": "currency",
            "type": "string",
            "required": true
          },
          {
            "name": "bank",
            "type": "string"
          },
          {
            "name": "proposed_by",
            "type": "string",
            "required": true
          },
          {
            "name": "occurred_at",
            "type": "date"
          }
        ],
        "emits": "bank_account.proposed",
        "who": [
          "human"
        ]
      }
    },
    {
      "name": "approve_bank_account",
      "domain": "finance",
      "description": "Osoba z Bankowości zatwierdza zgłoszony rachunek — nigdy ta, która go zgłosiła, chyba że jest w Bankowości sama; od teraz wyciągi z niego trafiają do ksiąg, także te, które czekały",
      "spec": {
        "inputs": [
          {
            "name": "bank_account",
            "type": "ref<bank_account>",
            "required": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "approved_by",
            "type": "string",
            "required": true
          },
          {
            "name": "occurred_at",
            "type": "date"
          }
        ],
        "emits": "bank_account.approved",
        "who": [
          "human"
        ]
      }
    },
    {
      "name": "reject_bank_account",
      "domain": "finance",
      "description": "Osoba z Bankowości odrzuca zgłoszony rachunek, z powodem — wyciągi z niego dalej czekają",
      "spec": {
        "inputs": [
          {
            "name": "bank_account",
            "type": "ref<bank_account>",
            "required": true
          },
          {
            "name": "reason",
            "type": "string",
            "required": true
          },
          {
            "name": "rejected_by",
            "type": "string",
            "required": true
          },
          {
            "name": "occurred_at",
            "type": "date"
          }
        ],
        "emits": "bank_account.rejected",
        "who": [
          "human"
        ]
      }
    },
    {
      "name": "close_bank_account",
      "domain": "finance",
      "description": "Osoba z Bankowości zamyka rachunek z dniem zamknięcia",
      "spec": {
        "inputs": [
          {
            "name": "bank_account",
            "type": "ref<bank_account>",
            "required": true
          },
          {
            "name": "closed_on",
            "type": "date",
            "required": true
          },
          {
            "name": "closed_by",
            "type": "string",
            "required": true
          },
          {
            "name": "occurred_at",
            "type": "date"
          }
        ],
        "emits": "bank_account.closed",
        "who": [
          "human"
        ]
      }
    },
    {
      "name": "classify_bank_operation",
      "domain": "finance",
      "description": "Osoba mówi, czym jest pozycja wyciągu, której nic nie rozliczyło: pieniądze właściciela, podatek, ZUS, przelew własny, opłata albo odsetki — pozycja przechodzi z rozrachunków z kontrahentami na swoje konto i przestaje czekać",
      "spec": {
        "inputs": [
          {
            "name": "operation",
            "type": "ref<bank_operation>",
            "required": true
          },
          {
            "name": "kind",
            "type": "enum",
            "required": true,
            "values": [
              "owner",
              "tax",
              "zus",
              "own",
              "fee",
              "interest"
            ]
          },
          {
            "name": "occurred_at",
            "type": "date"
          }
        ],
        "emits": "bank_operation.classified",
        "who": [
          "human"
        ]
      }
    }
  ],
  "rules": [
    {
      "rule_id": "pl-propose-bank-account",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Zgłoszony rachunek bankowy firmy staje się rachunkiem do zatwierdzenia: zgłosiła go osoba",
      "spec": {
        "match": {
          "event_type": "bank_account.proposed"
        },
        "effect": {
          "object": {
            "type": "bank_account",
            "fields": {
              "name": "=$.name",
              "number": "=$.number",
              "currency": "=$.currency",
              "bank": "=$.bank",
              "status": "proposed",
              "source": "person",
              "proposed_by": "=$.proposed_by"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-bank-account-from-statement",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Rachunek, z którego przyszedł wyciąg, a którego nikt nie zgłosił, staje się rachunkiem do zatwierdzenia: zgłosił go wyciąg; numer, który nie jest IBAN-em, nie staje się niczym — rachunek zgłasza wtedy osoba",
      "spec": {
        "match": {
          "event_type": "bank.account.seen",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            },
            {
              "formula": "=is_iban($.account)"
            },
            {
              "formula": "=count(a in objects(bank_account, number, $.account)) = 0"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "bank_account",
            "fields": {
              "name": "=$.account",
              "number": "=$.account",
              "currency": "=$.currency",
              "status": "proposed",
              "source": "statement",
              "seen_on": "=$.date"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-bank-account-on-statement",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Rachunek już zgłoszony, z którego przyszedł pierwszy wyciąg, zapisuje dzień tego wyciągu",
      "spec": {
        "match": {
          "event_type": "bank.account.seen",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            },
            {
              "formula": "=count(a in objects(bank_account, number, $.account)) > 0"
            }
          ]
        },
        "effect": {
          "amend": {
            "type": "bank_account",
            "target": "=ref(bank_account, number, $.account)",
            "set": {
              "seen_on": "=$.date"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-approve-bank-account",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Zatwierdzony rachunek bankowy jest rachunkiem firmy: kto zatwierdził, i nazwa, jeśli ją poprawił",
      "spec": {
        "match": {
          "event_type": "bank_account.approved"
        },
        "effect": {
          "amend": {
            "type": "bank_account",
            "target": "=$.bank_account",
            "set": {
              "status": "active",
              "approved_by": "=$.approved_by",
              "name": "=$.name"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-reject-bank-account",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Odrzucony rachunek bankowy nie jest rachunkiem firmy: z powodem",
      "spec": {
        "match": {
          "event_type": "bank_account.rejected"
        },
        "effect": {
          "amend": {
            "type": "bank_account",
            "target": "=$.bank_account",
            "set": {
              "status": "rejected",
              "reason": "=$.reason"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-close-bank-account",
      "version": 1,
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Zamknięty rachunek bankowy jest zamknięty z dniem zamknięcia",
      "spec": {
        "match": {
          "event_type": "bank_account.closed"
        },
        "effect": {
          "amend": {
            "type": "bank_account",
            "target": "=$.bank_account",
            "set": {
              "status": "closed",
              "closed_on": "=$.closed_on"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-bank-operation",
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Pozycja wyciągu bankowego staje się operacją bankową i najpierw mówi, czym jest: opłata (NCHG, NCOM) i odsetki (NINT) po kodzie banku; przelew między własnymi rachunkami, wpłata na mikrorachunek podatkowy, na rachunek składkowy ZUS, pieniądze właściciela — po rachunku drugiej strony, jak go podała firma; reszta to zapłata kontrahenta (transfer), otwarta na swoją kwotę do rozliczenia z fakturami (rynek pl: kanał bankowy pakietu stempluje go)",
      "spec": {
        "match": {
          "event_type": "bank.statement.line",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "bank_operation",
            "fields": {
              "date": "=$.date",
              "amount": "=$.amount",
              "currency": "=$.currency",
              "direction": "=$.direction",
              "title": "=$.reference",
              "counterparty": "=$.counterparty",
              "counterparty_account": "=$.counterparty_account",
              "account": "=$.account",
              "kind": "=if(coalesce($.code, \"\") = \"NCHG\" or coalesce($.code, \"\") = \"NCOM\", \"fee\", if(coalesce($.code, \"\") = \"NINT\", \"interest\", if(any(c in objects(company, iban, coalesce($.counterparty_account, \"-\")) : c.kind = \"self\"), \"own\", if(any(c in objects(company, tax_account, coalesce($.counterparty_account, \"-\")) : c.kind = \"self\"), \"tax\", if(any(c in objects(company, zus_account, coalesce($.counterparty_account, \"-\")) : c.kind = \"self\"), \"zus\", if(any(c in objects(company, owner_account, coalesce($.counterparty_account, \"-\")) : c.kind = \"self\"), \"owner\", \"transfer\"))))))",
              "open": "=$.amount",
              "settlement_status": "unsettled"
            }
          }
        }
      },
      "warrant": {
        "basis": "statute",
        "citations": [
          "Ordynacja podatkowa art. 61b § 1 (mikrorachunek podatkowy) i ustawa o systemie ubezpieczeń społecznych art. 47 ust. 4 (rachunek składkowy): wpłata podatku i składek ma swój rachunek — po nim ją poznać",
          "przegląd MON-07: każdą pozycję najpierw klasyfikuje się, a dopiero potem księguje i rozlicza; nieznana czeka na osobę",
          "SWIFT MT940 :61: kod transakcji — NTRF przelew, NCHG opłata, NCOM prowizja, NINT odsetki"
        ],
        "scope": "pl"
      }
    },
    {
      "rule_id": "pl-post-incoming-payment",
      "priority": 200,
      "effective_from": "2026-01-01",
      "description": "Wpływ na rachunek księguje się: Wn 130 / Ma 201 — gdy operacja jest zapłatą kontrahenta (transfer); w walucie obcej — po kursie z dnia operacji",
      "spec": {
        "match": {
          "event_type": "object.materialized",
          "where": [
            {
              "path": "$.object_type",
              "op": "eq",
              "value": "bank_operation"
            },
            {
              "path": "$.state.direction",
              "op": "eq",
              "value": "credit"
            },
            {
              "path": "$.state.kind",
              "op": "eq",
              "value": "transfer"
            }
          ]
        },
        "effect": {
          "postings": {
            "book": "pl-stat",
            "currency": "=$.state.currency",
            "lines": [
              {
                "account": "130",
                "debit": "=$.state.amount"
              },
              {
                "account": "201",
                "credit": "=$.state.amount"
              }
            ],
            "convert": {
              "to": "PLN",
              "date": "=$.state.date",
              "rounding": "half_up",
              "rounding_account": "756"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-post-outgoing-payment",
      "priority": 200,
      "effective_from": "2026-01-01",
      "description": "Wypływ z rachunku księguje się: Wn 202 / Ma 130 — gdy operacja jest zapłatą kontrahenta (transfer); w walucie obcej — po kursie z dnia operacji",
      "spec": {
        "match": {
          "event_type": "object.materialized",
          "where": [
            {
              "path": "$.object_type",
              "op": "eq",
              "value": "bank_operation"
            },
            {
              "path": "$.state.direction",
              "op": "eq",
              "value": "debit"
            },
            {
              "path": "$.state.kind",
              "op": "eq",
              "value": "transfer"
            }
          ]
        },
        "effect": {
          "postings": {
            "book": "pl-stat",
            "currency": "=$.state.currency",
            "lines": [
              {
                "account": "202",
                "debit": "=$.state.amount"
              },
              {
                "account": "130",
                "credit": "=$.state.amount"
              }
            ],
            "convert": {
              "to": "PLN",
