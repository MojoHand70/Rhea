      }
    },
    {
      "rule_id": "pl-declare-financial-year",
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Miesiąc, od którego zaczyna się rok obrotowy firmy, jak go podała — na jej własnym zapisie",
      "spec": {
        "match": {
          "event_type": "company.financial_year.declared"
        },
        "effect": {
