  "rules": [
    {
      "rule_id": "pl-book-sales-invoice",
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Wystawiona faktura sprzedaży staje się dokumentem sales_invoice; kwota otwarta zaczyna się od brutto, status od open; data sprzedaży to data dostawy lub wykonania usługi, a gdy faktura jej nie podaje — data wystawienia; okres VAT = miesiąc obowiązku podatkowego, czyli miesiąc sprzedaży (nie wystawienia); netto i VAT w złotych po kursie średnim NBP z ostatniego dnia roboczego przed dniem sprzedaży (dla PLN — te same kwoty); rodzaj sprzedaży (kind) mówi, co sprzedano — bez wskazania: usługi",
      "spec": {
        "match": {
          "event_type": "sales.invoice.issued",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "sales_invoice",
            "fields": {
              "number": "=$.number",
              "issue_date": "=$.issue_date",
              "buyer": "=ref(company, vat_id, $.buyer_nip)",
              "net": "=$.net",
              "vat": "=$.vat",
              "gross": "=$.gross",
              "vat_rate": "=ref(vat_rate, code, $.vat_rate)",
              "currency": "=$.currency",
              "seller": "=ref(company, vat_id, $.seller_nip)",
              "intragroup": "=$.intragroup",
              "seller_nip": "=$.seller_nip",
              "buyer_nip": "=$.buyer_nip",
              "open": "=$.gross",
              "status": "open",
              "vat_period": "=month(coalesce($.sale_date, $.issue_date))",
              "sale_date": "=coalesce($.sale_date, $.issue_date)",
              "net_pln": "=round($.net * fx($.currency, \"PLN\", coalesce($.sale_date, $.issue_date)), 2, half_up)",
              "vat_pln": "=round($.vat * fx($.currency, \"PLN\", coalesce($.sale_date, $.issue_date)), 2, half_up)",
              "kind": "=coalesce($.kind, \"services\")"
            }
          }
        }
      },
      "version": 4,
      "warrant": {
        "basis": "statute",
        "citations": [
          "ustawa o VAT art. 19a ust. 1: „Obowiązek podatkowy powstaje z chwilą dokonania dostawy towarów lub wykonania usługi”",
          "ustawa o VAT art. 106i ust. 1: fakturę wystawia się nie później niż 15. dnia miesiąca następującego po miesiącu dostawy — stąd sprzedaż wrześniowa z fakturą październikową należy do września",
          "FA(3) P_6 (art. 106e ust. 1 pkt 6): „Data dokonania lub zakończenia dostawy towarów lub wykonania usługi (...) o ile taka data jest określona i różni się od daty wystawienia faktury”",
          "poza tą regułą (kolejne wersje): usługi okresowe (art. 19a ust. 3), media, najem i stała obsługa (ust. 5 pkt 4, ust. 7), zaliczki (ust. 8)",
          "ustawa o VAT art. 31a ust. 1: kwoty w walucie obcej przelicza się na złote według kursu średniego NBP z ostatniego dnia roboczego poprzedzającego dzień powstania obowiązku podatkowego",
          "ustawa o VAT art. 106e ust. 11: kwota podatku na fakturze w walucie obcej jest wykazana w złotych",
          "ustawa o rachunkowości art. 30 ust. 2 pkt 2: po kursie średnim NBP z dnia poprzedzającego; ustawa o CIT art. 12 ust. 2, ustawa o PIT art. 11a ust. 1: przychód — po kursie z ostatniego dnia roboczego przed jego dniem",
          "kurs „dnia d” w Rhea to kurs, po którym przelicza się dokument z dnia d (kanał pl-nbp publikuje go z tabeli z ostatniego dnia roboczego przed d) — stąd fx(waluta, \"PLN\", dzień sprzedaży)"
        ],
        "scope": "pl"
      }
    },
    {
      "rule_id": "pl-post-sales-invoice",
      "priority": 200,
      "effective_from": "2026-01-01",
      "description": "Faktura sprzedaży z VAT księguje się: 201 brutto / 700 netto, 222 VAT; w walucie obcej — po kursie z dnia sprzedaży, tym samym co VAT w złotych — gdy sprzedano usługi (faktura bez rodzaju to usługi)",
      "spec": {
        "match": {
          "event_type": "sales.invoice.issued",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            },
            {
              "formula": "=$.vat > 0"
            },
            {
              "formula": "=coalesce($.kind, \"services\") = \"services\""
            }
          ]
        },
        "effect": {
          "postings": {
            "currency": "=$.currency",
            "lines": [
              {
                "account": "201",
                "debit": "=$.gross"
              },
              {
                "account": "700",
                "credit": "=$.net"
              },
              {
                "account": "222",
                "credit": "=$.vat"
              }
            ],
            "book": "pl-stat",
            "convert": {
              "to": "PLN",
              "date": "=coalesce($.sale_date, $.issue_date)",
              "rounding": "half_up",
              "rounding_account": "756"
            }
          }
        }
      },
      "warrant": {
        "basis": "practice",
        "scope": "pl",
        "citations": [
          "wzorcowy plan kont dla małych i średnich przedsiębiorstw: Wn 201 rozrachunki z odbiorcami / Ma 70x przychody ze sprzedaży, Ma 222 VAT należny",
          "ustawa o rachunkowości art. 30 ust. 2 pkt 2: po kursie średnim NBP z dnia poprzedzającego; ustawa o CIT art. 12 ust. 2, ustawa o PIT art. 11a ust. 1: przychód — po kursie z ostatniego dnia roboczego przed jego dniem"
        ]
      }
    },
    {
      "rule_id": "pl-post-sales-invoice-no-vat",
      "priority": 200,
      "effective_from": "2026-01-01",
      "description": "Faktura sprzedaży bez VAT (zwolniona, 0%, sprzedawca zwolniony) księguje się: 201 brutto / 700 netto — bez linii VAT, której kwota byłaby zerem; w walucie obcej — po kursie z dnia sprzedaży, tym samym co VAT w złotych — gdy sprzedano usługi (faktura bez rodzaju to usługi)",
      "spec": {
        "match": {
          "event_type": "sales.invoice.issued",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            },
            {
              "formula": "=not ($.vat > 0)"
            },
            {
              "formula": "=coalesce($.kind, \"services\") = \"services\""
            }
          ]
        },
        "effect": {
          "postings": {
            "currency": "=$.currency",
            "lines": [
              {
                "account": "201",
                "debit": "=$.gross"
              },
              {
                "account": "700",
                "credit": "=$.net"
              }
            ],
            "book": "pl-stat",
            "convert": {
              "to": "PLN",
              "date": "=coalesce($.sale_date, $.issue_date)",
              "rounding": "half_up",
              "rounding_account": "756"
            }
          }
        }
      },
      "warrant": {
        "basis": "statute",
        "citations": [
          "ustawa o VAT art. 113 ust. 1 (zwolnienie podmiotowe) i art. 43 (zwolnienia przedmiotowe): sprzedaż bez podatku należnego",
          "wzorcowy plan kont: Wn 201 / Ma 70x",
          "ustawa o rachunkowości art. 30 ust. 2 pkt 2: po kursie średnim NBP z dnia poprzedzającego; ustawa o CIT art. 12 ust. 2, ustawa o PIT art. 11a ust. 1: przychód — po kursie z ostatniego dnia roboczego przed jego dniem"
        ],
        "scope": "pl"
      }
    },
