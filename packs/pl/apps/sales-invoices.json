            },
            {
              "path": "$.state.status",
              "op": "eq",
              "value": "rejected"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "task",
            "fields": {
              "title": "Faktura odrzucona przez KSeF",
              "status": "open",
              "due_date": "=$.state.date",
              "priority": "high",
              "category": "invoices",
              "description": "=$.state.reason"
