    {
      "view_id": "rejestr-vat-sprzedazy",
      "version": 3,
      "notion": "analysis",
      "title": "Rejestr VAT sprzedaży",
      "domain": "finance",
      "function": "vat",
      "spec": {
        "sql": "SELECT month, rate, n AS net, v AS vat, g AS gross FROM (SELECT substr(json_extract_string(i.state,'$.issue_date'),1,7) AS month, json_extract_string(r.state,'$.code') AS rate, SUM(CAST(json_extract(i.state,'$.net') AS BIGINT)) AS n, SUM(CAST(json_extract(i.state,'$.vat') AS BIGINT)) AS v, SUM(CAST(json_extract(i.state,'$.gross') AS BIGINT)) AS g FROM objects i JOIN objects r ON json_extract_string(i.state,'$.vat_rate') = r.object_id JOIN objects c ON json_extract_string(i.state,'$.seller') = c.object_id WHERE c.object_type = 'company' AND json_extract_string(c.state,'$.country') = 'PL' AND i.object_type = 'sales_invoice' AND r.object_type = 'vat_rate' GROUP BY 1, 2) ORDER BY month, rate",
        "columns": [
          {
            "field": "month",
            "label": "Miesiąc",
            "type": "string"
          },
          {
            "field": "rate",
            "label": "Stawka",
            "type": "string"
          },
          {
            "field": "net",
            "label": "Netto",
            "type": "money"
          },
          {
            "field": "vat",
            "label": "VAT",
            "type": "money"
          },
          {
            "field": "gross",
            "label": "Brutto",
            "type": "money"
          }
        ]
      }
    },
