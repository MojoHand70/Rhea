    { "event_type": "vat_rate.defined", "occurred_at": "2026-01-01", "dedup_key": "pack/pl/vat/23", "payload": { "code": "23", "name": "Stawka podstawowa 23%", "percent": 23 } },
    { "event_type": "vat_rate.defined", "occurred_at": "2026-01-01", "dedup_key": "pack/pl/vat/8", "payload": { "code": "8", "name": "Stawka obniżona 8%", "percent": 8 } },
    { "event_type": "vat_rate.defined", "occurred_at": "2026-01-01", "dedup_key": "pack/pl/vat/5", "payload": { "code": "5", "name": "Stawka obniżona 5%", "percent": 5 } },
    { "event_type": "vat_rate.defined", "occurred_at": "2026-01-01", "dedup_key": "pack/pl/vat/0", "payload": { "code": "0", "name": "Stawka 0%", "percent": 0 } },
    { "event_type": "vat_rate.defined", "occurred_at": "2026-01-01", "dedup_key": "pack/pl/vat/zw", "payload": { "code": "zw", "name": "Zwolnione z VAT", "percent": 0 } }
  ]
}
