  "rules": [
    {
      "rule_id": "pl-register-account",
      "priority": 10,
      "effective_from": "2026-01-01",
      "description": "Konto z planu kont staje się obiektem account",
      "spec": {
        "match": {
          "event_type": "account.created",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "account",
            "fields": {
              "code": "=$.code",
              "name": "=$.name",
              "type": "=$.type"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-register-vat-rate",
      "priority": 10,
      "effective_from": "2026-01-01",
      "description": "Stawka VAT staje się obiektem vat_rate",
      "spec": {
        "match": {
          "event_type": "vat_rate.defined",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "vat_rate",
            "fields": {
              "code": "=$.code",
              "name": "=$.name",
              "percent": "=$.percent"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-book-sales-invoice",
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Wystawiona faktura sprzedaży staje się dokumentem sales_invoice",
      "spec": {
        "match": {
          "event_type": "sales.invoice.issued",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            }
          ]
        },
        "effect": {
          "object": {
            "type": "sales_invoice",
            "fields": {
              "number": "=$.number",
              "issue_date": "=$.issue_date",
              "buyer": "=ref(company, vat_id, $.buyer_nip)",
              "net": "=$.net",
              "vat": "=$.vat",
              "gross": "=$.gross",
              "vat_rate": "=ref(vat_rate, code, $.vat_rate)",
              "currency": "=$.currency",
              "seller": "=ref(company, vat_id, $.seller_nip)",
              "intragroup": "=$.intragroup",
              "seller_nip": "=$.seller_nip",
              "buyer_nip": "=$.buyer_nip"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-post-sales-invoice",
      "priority": 200,
      "effective_from": "2026-01-01",
      "description": "Faktura sprzedaży księguje się: 201 brutto / 700 netto, 222 VAT",
      "spec": {
        "match": {
          "event_type": "sales.invoice.issued",
          "where": [
            {
              "path": "$.market",
              "op": "eq",
              "value": "pl"
            }
          ]
        },
        "effect": {
          "postings": {
            "currency": "=$.currency",
            "lines": [
              {
                "account": "201",
                "debit": "=$.gross"
              },
              {
                "account": "700",
                "credit": "=$.net"
              },
              {
                "account": "222",
                "credit": "=$.vat"
              }
            ],
            "book": "pl-stat",
            "convert": {
              "to": "PLN",
              "date": "=$.issue_date",
              "rounding": "half_up",
              "rounding_account": "756"
            }
          }
        }
      }
    },
    {
      "rule_id": "pl-record-ksef-submission",
      "priority": 100,
      "effective_from": "2026-01-01",
      "description": "Potwierdzenie wysyłki do KSeF staje się obiektem ksef_submission (dowód: numer KSeF + UPO)",
      "spec": {
        "match": {
          "event_type": "ksef.invoice.submitted"
        },
        "effect": {
          "object": {
            "type": "ksef_submission",
            "fields": {
              "invoice": "=ref(sales_invoice, number, $.number)",
              "ksef_ref": "=$.ksef_ref",
              "upo": "=$.upo",
              "date": "=$.date"
            }
          }
        }
      }
    }
  ],
