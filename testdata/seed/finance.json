{
  "object_types": [
    {
      "name": "invoice",
      "version": 1,
      "domain": "finance",
      "is_document": true,
      "fields": [
        { "name": "customer", "type": "string", "required": true },
        { "name": "issue_date", "type": "date", "required": true },
        { "name": "currency", "type": "string", "required": true },
        { "name": "total", "type": "money", "required": true }
      ]
    }
  ],
  "view_defs": [
    {
      "view_id": "invoice-list",
      "version": 1,
      "notion": "list",
      "title": "Invoices",
      "domain": "finance",
      "function": "documents",
      "spec": {
        "object_type": "invoice",
        "columns": [
          { "field": "customer", "label": "Customer" },
          { "field": "issue_date", "label": "Issue date" },
          { "field": "currency", "label": "Currency" },
          { "field": "total", "label": "Total" }
        ]
      }
    },
    {
      "view_id": "invoice-detail",
      "version": 1,
      "notion": "detail",
      "title": "Invoice",
      "domain": "finance",
      "function": "documents",
      "spec": {
        "object_type": "invoice",
        "sections": [
          { "title": "Document", "fields": ["customer", "issue_date", "currency"] },
          { "title": "Amounts", "fields": ["total"] }
        ]
      }
    },
    {
      "view_id": "invoice-by-customer",
      "version": 1,
      "notion": "analysis",
      "title": "Invoice totals by customer",
      "domain": "finance",
      "function": "analysis",
      "spec": {
        "sql": "SELECT json_extract_string(state, '$.customer') AS customer, COUNT(*) AS invoices, printf('%d.%02d', SUM(CAST(json_extract(state, '$.total') AS BIGINT)) // 100, SUM(CAST(json_extract(state, '$.total') AS BIGINT)) % 100) AS total FROM objects WHERE object_type = 'invoice' GROUP BY 1 ORDER BY SUM(CAST(json_extract(state, '$.total') AS BIGINT)) DESC",
        "columns": [
          { "field": "customer", "label": "Customer" },
          { "field": "invoices", "label": "Invoices" },
          { "field": "total", "label": "Total" }
        ]
      }
    }
  ]
}
