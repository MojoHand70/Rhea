                  "set": {
                    "open": "=$.line.open_after.money",
                    "status": "=if($.line.open_after.money = 0, \"settled\", \"open\")"
                  }
                }
              }
            }
          },
          {
            "rule_id": "record-settlement",
            "description": "a settlement per invoice a match allocated: the payment, the document, the amount, the date",
            "priority": 320,
            "spec": {
              "match": {
                "event_type": "objects.matched",
                "where": [
                  {
                    "path": "$.sides.invoice[0]",
                    "op": "exists"
