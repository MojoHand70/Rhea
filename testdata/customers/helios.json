          {
            "rule_id": "settle-sales-invoice",
            "description": "a match moves the open amount of each sales invoice it allocated; paid when nothing stays open",
            "priority": 310,
            "spec": {
              "match": {
                "event_type": "objects.matched",
                "where": [
                  {
                    "path": "$.matching",
                    "op": "eq",
                    "value": "incoming-payments"
                  }
                ]
              },
              "effect": {
                "amend": {
                  "type": "sales_invoice",
                  "each": "=$.sides.invoice[*]",
                  "target": "=$.line.object_id",
                  "set": {
                    "open": "=$.line.open_after.money",
                    "status": "=if($.line.open_after.money = 0, \"paid\", \"open\")"
                  }
                }
              }
            }
          },
          {
            "rule_id": "settle-purchase-invoice",
            "description": "a match moves the open amount of each purchase invoice it allocated; paid when nothing stays open",
            "priority": 310,
            "spec": {
              "match": {
                "event_type": "objects.matched",
                "where": [
                  {
                    "path": "$.matching",
                    "op": "eq",
                    "value": "outgoing-payments"
                  }
                ]
              },
              "effect": {
                "amend": {
                  "type": "purchase_invoice",
                  "each": "=$.sides.invoice[*]",
                  "target": "=$.line.object_id",
                  "set": {
                    "open": "=$.line.open_after.money",
