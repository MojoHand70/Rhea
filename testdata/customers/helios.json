  "interview": [
    {
      "answer": "Our master data: the chart of accounts, the companies we deal with (ourselves, customers, suppliers), the services we sell as catalogue items, and the VAT rates each become their own master-data object; each company also carries its bank account number (IBAN) when we know it.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "master-data",
        "description": "Master data events become master-data objects.",
        "rules": [
          {
            "rule_id": "register-account",
            "description": "accounts",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "account.created"
              },
              "effect": {
                "object": {
                  "type": "account",
                  "fields": {
                    "code": "=$.code",
                    "name": "=$.name",
                    "type": "=$.type"
                  }
                }
              }
            }
          },
          {
