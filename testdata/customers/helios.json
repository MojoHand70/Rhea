          {
            "rule_id": "post-short-difference",
            "description": "a short difference posts in pl-stat: debit the difference account, credit 201",
            "priority": 330,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
