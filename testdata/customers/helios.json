    {
      "answer": "Customer complaints are registered as complaint documents (number, customer, details). Every complaint opens a follow-up case: a new type named case, whose subject is the complaint number and whose status starts open and can later move to resolved.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "complaints",
        "description": "Complaints and their follow-up cases.",
        "object_types": [
          {
            "name": "complaint",
            "domain": "sales",
            "is_document": true,
            "label_field": "number",
            "fields": [
              {
                "name": "number",
                "type": "string",
                "required": true
              },
              {
                "name": "customer",
                "type": "string",
                "required": true
              },
              {
                "name": "details",
                "type": "string",
                "required": false
              }
            ]
          },
          {
            "name": "case",
            "domain": "work",
            "label_field": "subject",
            "fields": [
              {
                "name": "subject",
                "type": "string",
                "required": true
              },
              {
                "name": "status",
                "type": "enum",
                "required": true,
                "values": [
                  "open",
                  "resolved"
                ]
              }
            ],
            "lifecycle": {
              "field": "status",
              "transitions": {
                "open": [
                  "resolved"
                ]
              }
            }
          }
        ],
        "rules": [
          {
            "rule_id": "book-complaint",
            "description": "complaint documents",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "complaint.registered"
              },
              "effect": {
                "object": {
                  "type": "complaint",
                  "fields": {
                    "number": "=$.number",
                    "customer": "=$.customer",
                    "details": "=$.details"
                  }
                }
              }
            }
          },
          {
            "rule_id": "raise-complaint-case",
            "description": "a case per complaint",
            "priority": 200,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "complaint"
                  }
                ]
              },
              "effect": {
                "object": {
                  "type": "case",
                  "fields": {
                    "subject": "=$.state.number",
                    "status": "open"
                  }
                }
              }
            }
          }
        ],
        "warrant": {
          "basis": "practice",
          "citations": [
            "obsługa reklamacji jako sprawa z cyklem życia"
          ],
          "scope": "any market"
        }
      }
    },
    {
      "answer": "When a customer withdraws a complaint, its case is resolved.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "withdrawals",
        "description": "A withdrawal resolves the complaint's case.",
        "rules": [
          {
            "rule_id": "resolve-on-withdrawal",
            "description": "withdrawal resolves the case",
            "priority": 300,
            "spec": {
              "match": {
                "event_type": "complaint.withdrawn"
              },
              "effect": {
                "amend": {
                  "type": "case",
                  "target": "=ref(case, subject, $.number)",
                  "set": {
                    "status": "resolved"
                  }
                }
              }
            }
          }
        ],
        "warrant": {
          "basis": "practice",
          "citations": [
            "wycofana reklamacja zamyka jej sprawę"
          ],
          "scope": "any market"
        }
      }
    }
  ]
