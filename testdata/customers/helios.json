                  },
                  {
                    "path": "$.state.direction",
                    "op": "eq",
                    "value": "short"
                  }
                ]
              },
              "effect": {
                "postings": {
                  "book": "pl-stat",
                  "currency": "=$.state.currency",
                  "lines": [
                    {
                      "account": "=$.state.account",
                      "debit": "=$.state.amount"
                    },
                    {
                      "account": "201",
                      "credit": "=$.state.amount"
                    }
                  ]
                }
              }
            }
          }
