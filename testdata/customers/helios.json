                    "matching": "=$.doc.matching",
                    "kind": "=$.line.kind",
                    "amount": "=$.line.amount",
                    "currency": "=$.line.currency",
                    "direction": "=$.line.direction",
                    "account": "=$.line.account",
                    "date": "=$.root.date"
                  }
                }
