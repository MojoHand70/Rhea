    {
      "answer": "Every sales invoice we issue becomes a sales invoice document (the type sales_invoice): number, issue date, the seller and the buyer found by NIP, the net amount, the currency and the VAT rate code from the invoice. VAT is the net times the rate's percent divided by 100, rounded half up to the grosz; gross is net plus VAT; the due date is the issue date plus the payment days printed on the invoice; the status starts open and can later move to paid. The open amount starts at the gross and goes down as payments are matched; a partly paid invoice stays open. Each sales invoice is posted in the book pl-stat: debit 201 with the gross, credit 701 with the net, credit 222 with the VAT.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "sales-invoices",
        "description": "Sales invoices become documents with computed VAT and post to the statutory book.",
        "object_types": [
          {
            "name": "sales_invoice",
            "domain": "finance",
            "is_document": true,
            "label_field": "number",
            "fields": [
              {
                "name": "number",
                "type": "string",
                "required": true
              },
              {
                "name": "issue_date",
                "type": "date",
                "required": true
              },
              {
                "name": "due_date",
                "type": "date",
                "required": true
              },
              {
                "name": "seller",
                "type": "ref<company>",
                "required": true
              },
              {
                "name": "buyer",
                "type": "ref<company>",
                "required": true
              },
              {
                "name": "net",
                "type": "money",
                "required": true
              },
              {
                "name": "vat",
                "type": "money",
                "required": true
              },
              {
                "name": "gross",
                "type": "money",
                "required": true
              },
              {
                "name": "vat_rate",
                "type": "ref<vat_rate>",
                "required": true
              },
              {
                "name": "currency",
                "type": "string",
                "required": true
              },
              {
                "name": "status",
                "type": "enum",
                "required": true,
                "values": [
                  "open",
                  "paid"
                ]
              },
              {
                "name": "open",
                "type": "money",
                "required": true
              }
            ],
            "lifecycle": {
              "field": "status",
              "transitions": {
                "open": [
                  "open",
                  "paid"
                ]
              }
            },
            "amendable": [
              "open"
            ]
          }
        ],
        "rules": [
          {
            "rule_id": "book-sales-invoice",
            "description": "sales invoice documents with VAT computed and rounded",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "sales.invoice.issued"
              },
              "effect": {
                "object": {
                  "type": "sales_invoice",
                  "fields": {
                    "number": "=$.number",
                    "issue_date": "=$.issue_date",
                    "due_date": "=$.issue_date + $.payment_days",
                    "seller": "=ref(company, vat_id, $.seller_nip)",
                    "buyer": "=ref(company, vat_id, $.buyer_nip)",
                    "net": "=$.net",
                    "vat": "=round($.net * ref(vat_rate, code, $.vat_rate).percent / 100, 2, half_up)",
                    "gross": "=$.net + round($.net * ref(vat_rate, code, $.vat_rate).percent / 100, 2, half_up)",
                    "vat_rate": "=ref(vat_rate, code, $.vat_rate)",
                    "currency": "=$.currency",
                    "status": "open",
                    "open": "=$.net + round($.net * ref(vat_rate, code, $.vat_rate).percent / 100, 2, half_up)"
                  }
                }
              }
            }
          },
          {
            "rule_id": "post-sales-invoice",
            "description": "a sales invoice posts 201 gross / 701 net, 222 VAT",
            "priority": 200,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "sales_invoice"
                  }
                ]
              },
              "effect": {
                "postings": {
                  "book": "pl-stat",
                  "currency": "=$.state.currency",
                  "lines": [
                    {
                      "account": "201",
                      "debit": "=$.state.gross"
                    },
                    {
                      "account": "701",
                      "credit": "=$.state.net"
                    },
                    {
                      "account": "222",
                      "credit": "=$.state.vat"
                    }
                  ]
                }
              }
            }
          }
        ],
        "warrant": {
          "basis": "statute",
          "citations": [
            "ustawa o VAT art. 106e: kwoty podatku zaokrągla się do pełnych groszy",
            "ewidencja sprzedaży: Wn 201 / Ma 70x, Ma 222"
          ],
          "scope": "PL"
        }
      }
    },
