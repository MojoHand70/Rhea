            "priority": 100,
            "spec": {
              "match": {
                "event_type": "goods.issued"
              },
              "effect": {
                "object": {
                  "type": "goods_issue",
                  "fields": {
                    "item": "=ref(item, sku, $.item)",
                    "location": "=ref(location, code, $.location)",
                    "qty": "=$.qty",
                    "date": "=$.date",
                    "reason": "=$.reason"
                  }
                }
              }
            }
          },
          {
