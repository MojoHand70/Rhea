    {
      "answer": "A bank statement line whose reference names one of our sales invoice numbers marks that sales invoice as paid.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "bank-payments",
        "description": "A bank line naming a sales invoice marks it paid.",
        "rules": [
          {
            "rule_id": "pay-sales-invoice",
            "description": "a bank line settles the invoice it names",
            "priority": 300,
            "spec": {
              "match": {
                "event_type": "bank.statement.line"
              },
              "effect": {
                "amend": {
                  "type": "sales_invoice",
                  "target": "=ref(sales_invoice, number, $.reference)",
                  "set": {
                    "status": "paid"
                  }
                }
              }
            }
          }
        ],
        "warrant": {
          "basis": "practice",
          "citations": [
            "rozliczenie należności z wyciągu bankowego po numerze faktury"
          ],
          "scope": "any market"
        }
      }
    },
    {
      "answer": "Customer complaints are registered as complaint documents (number, customer, details). Every complaint opens a follow-up case: a new type named case, whose subject is the complaint number and whose status starts open and can later move to resolved.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "complaints",
        "description": "Complaints and their follow-up cases.",
        "object_types": [
          {
            "name": "complaint",
            "domain": "sales",
            "is_document": true,
            "label_field": "number",
            "fields": [
              {
                "name": "number",
                "type": "string",
                "required": true
              },
              {
                "name": "customer",
                "type": "string",
                "required": true
              },
              {
                "name": "details",
                "type": "string",
                "required": false
              }
            ]
          },
          {
            "name": "case",
            "domain": "work",
            "label_field": "subject",
            "fields": [
              {
                "name": "subject",
                "type": "string",
                "required": true
              },
              {
                "name": "status",
                "type": "enum",
                "required": true,
                "values": [
                  "open",
                  "resolved"
                ]
              }
            ],
            "lifecycle": {
              "field": "status",
              "transitions": {
                "open": [
