            "rule_id": "record-stock-count",
            "description": "book quantity as the sum of movements up to the count date",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "stock.counted"
              },
              "effect": {
                "object": {
                  "type": "stock_level",
                  "fields": {
                    "item": "=ref(item, sku, $.item)",
                    "location": "=ref(location, code, $.location)",
                    "date": "=$.date",
                    "counted": "=$.counted",
                    "book": "=sum(m in objects(stock_movement, item, ref(item, sku, $.item)) where m.location = ref(location, code, $.location) and m.date <= $.date: if(m.direction = \"in\", m.qty, -m.qty))",
                    "difference": "=$.counted - sum(m in objects(stock_movement, item, ref(item, sku, $.item)) where m.location = ref(location, code, $.location) and m.date <= $.date: if(m.direction = \"in\", m.qty, -m.qty))"
