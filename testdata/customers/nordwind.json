  "interview": [
    {
      "answer": "Our master data: the chart of accounts, the companies we deal with (ourselves, customers, suppliers), the catalogue items, the warehouse locations and the VAT rates each become their own master-data object.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "master-data",
        "description": "Master data events become master-data objects.",
        "rules": [
          {
            "rule_id": "register-account",
            "description": "accounts",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "account.created"
              },
              "effect": {
                "object": {
                  "type": "account",
                  "fields": {
                    "code": "=$.code",
                    "name": "=$.name",
                    "type": "=$.type"
                  }
                }
              }
            }
          },
          {
            "rule_id": "register-company",
            "description": "companies",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "company.registered"
              },
              "effect": {
                "object": {
                  "type": "company",
                  "fields": {
                    "name": "=$.name",
                    "kind": "=$.kind",
                    "vat_id": "=$.vat_id",
                    "country": "=$.country"
                  }
                }
              }
            }
          },
          {
            "rule_id": "register-item",
            "description": "items",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "item.created"
              },
              "effect": {
                "object": {
                  "type": "item",
                  "fields": {
                    "sku": "=$.sku",
                    "name": "=$.name",
                    "unit": "=$.unit"
                  }
                }
              }
            }
          },
          {
            "rule_id": "register-vat-rate",
            "description": "VAT rates",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "vat_rate.defined"
              },
              "effect": {
                "object": {
                  "type": "vat_rate",
                  "fields": {
                    "code": "=$.code",
                    "name": "=$.name",
                    "percent": "=$.percent"
                  }
                }
              }
            }
          },
          {
            "rule_id": "register-location",
            "description": "locations",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "location.created"
              },
              "effect": {
                "object": {
                  "type": "location",
                  "fields": {
                    "code": "=$.code",
                    "name": "=$.name"
                  }
                }
              }
            }
          }
        ],
        "warrant": {
          "basis": "practice",
          "citations": [
            "master data as records of their own"
          ],
          "scope": "any market"
        }
      }
    },
    {
      "answer": "Every sales invoice we issue becomes a sales invoice document (the type sales_invoice): number, issue date, the seller and the buyer found by NIP, the net amount, the currency and the VAT rate code from the invoice. VAT is the net times the rate's percent divided by 100, rounded half up to the grosz; gross is net plus VAT; the due date is the issue date plus the payment days printed on the invoice; the status starts open and can later move to paid. Each sales invoice is posted in the book pl-stat: debit 201 with the gross, credit 700 with the net, credit 222 with the VAT.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "sales-invoices",
        "description": "Sales invoices become documents with computed VAT and post to the statutory book.",
        "object_types": [
          {
            "name": "sales_invoice",
            "domain": "finance",
            "is_document": true,
            "label_field": "number",
            "fields": [
              {
                "name": "number",
                "type": "string",
                "required": true
              },
              {
                "name": "issue_date",
                "type": "date",
                "required": true
              },
              {
                "name": "due_date",
                "type": "date",
                "required": true
              },
              {
                "name": "seller",
                "type": "ref<company>",
                "required": true
              },
              {
                "name": "buyer",
                "type": "ref<company>",
                "required": true
              },
              {
                "name": "net",
                "type": "money",
                "required": true
              },
              {
                "name": "vat",
                "type": "money",
                "required": true
              },
              {
                "name": "gross",
                "type": "money",
                "required": true
              },
              {
                "name": "vat_rate",
                "type": "ref<vat_rate>",
                "required": true
              },
              {
                "name": "currency",
                "type": "string",
                "required": true
              },
              {
                "name": "status",
                "type": "enum",
                "required": true,
                "values": [
                  "open",
                  "paid"
                ]
              }
            ],
            "lifecycle": {
              "field": "status",
              "transitions": {
                "open": [
                  "paid"
                ]
              }
            }
          }
        ],
        "rules": [
          {
            "rule_id": "book-sales-invoice",
            "description": "sales invoice documents with VAT computed and rounded",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "sales.invoice.issued"
              },
              "effect": {
                "object": {
                  "type": "sales_invoice",
                  "fields": {
                    "number": "=$.number",
                    "issue_date": "=$.issue_date",
                    "due_date": "=$.issue_date + $.payment_days",
                    "seller": "=ref(company, vat_id, $.seller_nip)",
                    "buyer": "=ref(company, vat_id, $.buyer_nip)",
                    "net": "=$.net",
                    "vat": "=round($.net * ref(vat_rate, code, $.vat_rate).percent / 100, 2, half_up)",
                    "gross": "=$.net + round($.net * ref(vat_rate, code, $.vat_rate).percent / 100, 2, half_up)",
                    "vat_rate": "=ref(vat_rate, code, $.vat_rate)",
                    "currency": "=$.currency",
                    "status": "open"
                  }
                }
              }
            }
          },
          {
            "rule_id": "post-sales-invoice",
            "description": "a sales invoice posts 201 gross / 700 net, 222 VAT",
            "priority": 200,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "sales_invoice"
                  }
                ]
              },
              "effect": {
                "postings": {
                  "book": "pl-stat",
                  "currency": "=$.state.currency",
                  "lines": [
                    {
                      "account": "201",
                      "debit": "=$.state.gross"
                    },
                    {
                      "account": "700",
                      "credit": "=$.state.net"
                    },
                    {
                      "account": "222",
                      "credit": "=$.state.vat"
                    }
                  ]
                }
              }
            }
          }
        ],
        "warrant": {
          "basis": "statute",
          "citations": [
            "ustawa o VAT art. 106e: kwoty podatku zaokrągla się do pełnych groszy",
            "ewidencja sprzedaży: Wn 201 / Ma 70x, Ma 222"
          ],
          "scope": "PL"
        }
      }
    },
    {
      "answer": "Every delivery gets one PZ document (goods received note; a new type named pz) with the supplier, the supplier's delivery document number, the warehouse location, the date and the currency. Each delivered item becomes a line of that PZ (a new type named pz_line) pointing at it, with the fields qty, price and value, the value being quantity times the unit price stated on the delivery. Every line moves that item's stock into the delivery's location and is posted in the book pl-stat at its value: debit 330, credit 300.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "deliveries",
        "description": "A delivery becomes a PZ with valued lines; each line moves stock in and posts at its value.",
        "object_types": [
          {
            "name": "pz",
            "domain": "warehouse",
            "is_document": true,
            "label_field": "supplier_document",
            "fields": [
              {
                "name": "supplier",
                "type": "ref<company>",
                "required": true
              },
              {
                "name": "supplier_document",
                "type": "string",
                "required": true
              },
              {
                "name": "location",
                "type": "ref<location>",
                "required": true
              },
              {
                "name": "date",
                "type": "date",
                "required": true
              },
              {
                "name": "currency",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "pz_line",
            "domain": "warehouse",
            "fields": [
              {
                "name": "document",
                "type": "ref<pz>",
                "required": true
              },
              {
                "name": "item",
                "type": "ref<item>",
                "required": true
              },
              {
                "name": "qty",
                "type": "int",
                "required": true
              },
              {
                "name": "price",
                "type": "decimal",
                "required": true
              },
              {
                "name": "value",
                "type": "money",
                "required": true
              }
            ]
          }
        ],
        "rules": [
          {
            "rule_id": "pz-from-delivery",
            "description": "one PZ per delivery",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "delivery.received"
              },
              "effect": {
                "object": {
                  "type": "pz",
                  "fields": {
                    "supplier": "=ref(company, name, $.supplier)",
                    "supplier_document": "=$.document",
                    "location": "=ref(location, code, $.location)",
                    "date": "=$.date",
                    "currency": "=$.currency"
                  }
                }
              }
            }
          },
          {
            "rule_id": "pz-lines",
            "description": "one valued line per delivered item",
            "priority": 200,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "pz"
                  }
                ]
              },
              "effect": {
                "object": {
                  "type": "pz_line",
                  "fields": {
                    "document": "=$.doc.object_id",
                    "item": "=ref(item, sku, $.line.item)",
                    "qty": "=$.line.qty",
                    "price": "=$.line.price",
                    "value": "=$.line.qty * $.line.price"
                  },
                  "each": "=$.root.lines[*]"
                }
              }
            }
          },
          {
            "rule_id": "pz-line-moves-stock",
            "description": "each line moves stock in",
            "priority": 300,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "pz_line"
                  }
                ]
              },
              "effect": {
                "object": {
                  "type": "stock_movement",
                  "fields": {
                    "item": "=$.state.item",
                    "location": "=ref(location, code, $.root.location)",
                    "direction": "in",
                    "qty": "=$.state.qty",
                    "date": "=$.root.date"
                  }
                }
              }
            }
          },
          {
            "rule_id": "pz-line-posts",
            "description": "each line posts Wn 330 / Ma 300 at its value",
            "priority": 310,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "pz_line"
                  }
                ]
              },
              "effect": {
                "postings": {
                  "book": "pl-stat",
                  "currency": "=$.root.currency",
                  "lines": [
                    {
                      "account": "330",
                      "debit": "=$.state.value"
                    },
                    {
                      "account": "300",
                      "credit": "=$.state.value"
                    }
                  ]
                }
              }
            }
          }
        ],
        "warrant": {
          "basis": "practice",
          "citations": [
            "PZ (przyjęcie zewnętrzne) dla każdej dostawy",
            "zapasy w cenie nabycia: Wn 330 / Ma 300 (ustawa o rachunkowości art. 28)"
          ],
          "scope": "PL, handel"
        }
      }
    },
    {
