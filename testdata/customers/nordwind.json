            "domain": "warehouse",
            "fields": [
              {
                "name": "item",
                "type": "ref<item>",
                "required": true
              },
              {
                "name": "location",
                "type": "ref<location>",
                "required": true
              },
              {
                "name": "date",
                "type": "date",
                "required": true
              },
