  "tasks": [
    {
      "intent": "Our master data: accounts, registered companies, catalogue items, warehouse locations and the exchange rates the bank publishes each become their master-data objects.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "master-data",
        "description": "Master data events become master-data objects.",
        "rules": [
          {
            "rule_id": "register-account",
            "description": "accounts",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "account.created"
              },
              "effect": {
                "object": {
                  "type": "account",
                  "fields": {
                    "code": "=$.code",
                    "name": "=$.name",
                    "type": "=$.type"
                  }
                }
              }
            }
          },
          {
            "rule_id": "register-company",
            "description": "companies",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "company.registered"
              },
              "effect": {
                "object": {
                  "type": "company",
                  "fields": {
                    "name": "=$.name",
                    "kind": "=$.kind",
                    "vat_id": "=$.vat_id",
                    "country": "=$.country"
                  }
                }
              }
            }
          },
          {
            "rule_id": "register-item",
            "description": "items",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "item.created"
              },
              "effect": {
                "object": {
                  "type": "item",
                  "fields": {
                    "sku": "=$.sku",
                    "name": "=$.name",
                    "unit": "=$.unit"
                  }
                }
              }
            }
          },
          {
            "rule_id": "register-location",
            "description": "locations",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "location.created"
              },
              "effect": {
                "object": {
                  "type": "location",
                  "fields": {
                    "code": "=$.code",
                    "name": "=$.name"
                  }
                }
              }
            }
          },
          {
            "rule_id": "register-fx-rate",
            "description": "rates",
            "priority": 10,
            "spec": {
              "match": {
                "event_type": "fx.rate.published"
              },
              "effect": {
                "object": {
                  "type": "fx_rate",
                  "fields": {
                    "code": "=$.code",
                    "base": "=$.base",
                    "quote": "=$.quote",
                    "date": "=$.date",
                    "rate": "=$.rate"
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "intent": "Received invoices become invoice documents for the customer, the total being the sum of the line amounts. Every invoice is posted twice: in the main book, debit 201 and credit 702 for the total in the invoice's currency; and in the statutory book 'pl-stat' in PLN, converted at the rate of the issue date, rounding half up with differences to account 756.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "invoices",
        "description": "Invoices become documents and post to two books.",
        "rules": [
          {
            "rule_id": "book-invoice",
            "description": "invoice documents",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "invoice.received"
              },
              "effect": {
                "object": {
                  "type": "invoice",
                  "fields": {
                    "customer": "=ref(company, name, $.customer)",
                    "issue_date": "=$.issue_date",
                    "currency": "=$.currency",
                    "total": "=sum($.lines[*].amount)"
                  }
                }
              }
            }
          },
          {
            "rule_id": "post-invoice-main",
            "description": "main book",
            "priority": 200,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "invoice"
                  }
                ]
              },
              "effect": {
                "postings": {
                  "currency": "=$.state.currency",
                  "lines": [
                    {
                      "account": "201",
                      "debit": "=$.state.total"
                    },
                    {
                      "account": "702",
                      "credit": "=$.state.total"
                    }
                  ]
                }
              }
            }
          },
          {
            "rule_id": "post-invoice-stat",
            "description": "statutory book",
            "priority": 210,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "invoice"
                  }
                ]
              },
              "effect": {
                "postings": {
                  "book": "pl-stat",
                  "currency": "=$.state.currency",
                  "convert": {
                    "to": "PLN",
                    "date": "=$.state.issue_date",
                    "rounding": "half_up",
                    "rounding_account": "756"
                  },
                  "lines": [
                    {
                      "account": "201",
                      "debit": "=$.state.total"
                    },
                    {
                      "account": "702",
                      "credit": "=$.state.total"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "intent": "Goods received from a supplier become goods receipts and move stock in; goods issued become goods issues and move stock out.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "goods",
        "description": "Goods documents and their stock movements.",
        "rules": [
          {
            "rule_id": "book-goods-receipt",
            "description": "receipts",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "goods.received"
              },
              "effect": {
                "object": {
                  "type": "goods_receipt",
                  "fields": {
                    "supplier": "=ref(company, name, $.supplier)",
                    "item": "=ref(item, sku, $.item)",
                    "location": "=ref(location, code, $.location)",
                    "qty": "=$.qty",
                    "date": "=$.date"
                  }
                }
              }
            }
          },
          {
            "rule_id": "move-stock-in",
            "description": "stock in",
            "priority": 110,
            "spec": {
              "match": {
                "event_type": "goods.received"
              },
              "effect": {
                "object": {
                  "type": "stock_movement",
                  "fields": {
                    "item": "=ref(item, sku, $.item)",
                    "location": "=ref(location, code, $.location)",
                    "direction": "in",
                    "qty": "=$.qty",
                    "date": "=$.date"
                  }
                }
              }
            }
          },
          {
            "rule_id": "book-goods-issue",
            "description": "issues",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "goods.issued"
              },
              "effect": {
                "object": {
                  "type": "goods_issue",
                  "fields": {
                    "item": "=ref(item, sku, $.item)",
                    "location": "=ref(location, code, $.location)",
                    "qty": "=$.qty",
                    "date": "=$.date",
                    "reason": "=$.reason"
                  }
                }
              }
            }
          },
          {
            "rule_id": "move-stock-out",
            "description": "stock out",
            "priority": 110,
            "spec": {
              "match": {
                "event_type": "goods.issued"
              },
              "effect": {
                "object": {
                  "type": "stock_movement",
                  "fields": {
                    "item": "=ref(item, sku, $.item)",
                    "location": "=ref(location, code, $.location)",
                    "direction": "out",
                    "qty": "=$.qty",
                    "date": "=$.date"
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "intent": "Every delivery gets one PZ document (goods received note): a new type named pz, recording the supplier, the supplier's delivery document number, the warehouse location and the date. Each delivered item becomes a line of that PZ (a new type named pz_line, pointing at its PZ), and every line moves that item's stock in at the delivery's location.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "deliveries",
        "description": "A delivery becomes a PZ with lines; each line moves stock in.",
        "object_types": [
          {
            "name": "pz",
            "domain": "warehouse",
            "is_document": true,
            "label_field": "supplier_document",
            "fields": [
              {
                "name": "supplier",
                "type": "ref<company>",
                "required": true
              },
              {
                "name": "supplier_document",
                "type": "string",
                "required": true
              },
              {
                "name": "location",
                "type": "ref<location>",
                "required": true
              },
              {
                "name": "date",
                "type": "date",
                "required": true
              }
            ]
          },
          {
            "name": "pz_line",
            "domain": "warehouse",
            "fields": [
              {
                "name": "document",
                "type": "ref<pz>",
                "required": true
              },
              {
                "name": "item",
                "type": "ref<item>",
                "required": true
              },
              {
                "name": "qty",
                "type": "int",
                "required": true
              }
            ]
          }
        ],
        "rules": [
          {
            "rule_id": "pz-from-delivery",
            "description": "one PZ per delivery",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "delivery.received"
              },
              "effect": {
                "object": {
                  "type": "pz",
                  "fields": {
                    "supplier": "=ref(company, name, $.supplier)",
                    "supplier_document": "=$.document",
                    "location": "=ref(location, code, $.location)",
                    "date": "=$.date"
                  }
                }
              }
            }
          },
          {
            "rule_id": "pz-lines",
            "description": "one line per delivered item",
            "priority": 200,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "pz"
                  }
                ]
              },
              "effect": {
                "object": {
                  "type": "pz_line",
                  "each": "=$.root.lines[*]",
                  "fields": {
                    "document": "=$.doc.object_id",
                    "item": "=ref(item, sku, $.line.item)",
                    "qty": "=$.line.qty"
                  }
                }
              }
            }
          },
          {
            "rule_id": "pz-line-moves-stock",
            "description": "each line moves stock in",
            "priority": 300,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "pz_line"
                  }
                ]
              },
              "effect": {
                "object": {
                  "type": "stock_movement",
                  "fields": {
                    "item": "=$.state.item",
                    "location": "=ref(location, code, $.root.location)",
                    "direction": "in",
                    "qty": "=$.state.qty",
                    "date": "=$.root.date"
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "intent": "Customer complaints are registered as complaint documents (number, customer, details). Every complaint opens a follow-up case: a new type named case, whose subject is the complaint number and whose status starts open and can later move to resolved.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "complaints",
        "description": "Complaints and their follow-up cases.",
        "object_types": [
          {
            "name": "complaint",
            "domain": "sales",
            "is_document": true,
            "label_field": "number",
            "fields": [
              {
                "name": "number",
                "type": "string",
                "required": true
              },
              {
                "name": "customer",
                "type": "string",
                "required": true
              },
              {
                "name": "details",
                "type": "string",
                "required": false
              }
            ]
          },
          {
            "name": "case",
            "domain": "work",
            "label_field": "subject",
            "fields": [
              {
                "name": "subject",
                "type": "string",
                "required": true
              },
              {
                "name": "status",
                "type": "enum",
                "values": [
                  "open",
                  "resolved"
                ],
                "required": true
              }
            ],
            "lifecycle": {
              "field": "status",
              "transitions": {
                "open": [
                  "resolved"
                ]
              }
            }
          }
        ],
        "rules": [
          {
            "rule_id": "book-complaint",
            "description": "complaint documents",
            "priority": 100,
            "spec": {
              "match": {
                "event_type": "complaint.registered"
              },
              "effect": {
                "object": {
                  "type": "complaint",
                  "fields": {
                    "number": "=$.number",
                    "customer": "=$.customer",
                    "details": "=$.details"
                  }
                }
              }
            }
          },
          {
            "rule_id": "raise-complaint-case",
            "description": "a case per complaint",
            "priority": 200,
            "spec": {
              "match": {
                "event_type": "object.materialized",
                "where": [
                  {
                    "path": "$.object_type",
                    "op": "eq",
                    "value": "complaint"
                  }
                ]
              },
              "effect": {
                "object": {
                  "type": "case",
                  "fields": {
                    "subject": "=$.state.number",
                    "status": "open"
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "intent": "When a customer withdraws a complaint, its case is resolved.",
      "mode": "bundle",
      "reference": {
        "bundle_id": "withdrawals",
        "description": "A withdrawal resolves the complaint's case.",
        "rules": [
          {
            "rule_id": "resolve-on-withdrawal",
            "description": "withdrawal resolves the case",
            "priority": 300,
            "spec": {
              "match": {
                "event_type": "complaint.withdrawn"
              },
              "effect": {
                "amend": {
                  "type": "case",
                  "target": "=ref(case, subject, $.number)",
                  "set": {
                    "status": "resolved"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
